# lorebase 环境变量样例（复制为真实 env 后 source，或注入容器；密钥永不入库）
# 数据库（默认 localhost，按部署改）
NEO4J_HTTP=http://localhost:7474
NEO4J_PASSWORD=
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=lorebase_chunks

# LLM（抽取/校验/问答主力：MiniMax-M3, OpenAI 兼容）
MINIMAX_API_KEY=
# embedding（dashscope qwen3.7, 1024 维）
DASHSCOPE_API_KEY=

# 语料配置（可选；不设则默认扫 corpus/*.md）
# LOREBASE_CORPUS=/path/vol1.md:/path/vol2.md
# LOREBASE_SKIP_TITLES=书名,副书名
# LOREBASE_YEAR_RE=(?:纪元前)(\d{1,4})年|(\d{3,4})年

# 可观测性（可选；三件套齐则上报 Langfuse）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
